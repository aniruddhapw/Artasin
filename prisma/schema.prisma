generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  ARTIST
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PortfolioMediaType {
  IMAGE
  VIDEO
}

enum BlogPostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum ArtworkStatus {
  DRAFT
  PUBLISHED
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum CommissionStatus {
  SUBMITTED
  ARTIST_REVIEW
  MEETING_REQUESTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  FINAL_REVIEW
  COMPLETED
  REJECTED
  CANCELLED
}

enum MeetingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TransactionStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String?
  googleId        String?             @unique
  firstName       String
  lastName        String
  role            UserRole            @default(BUYER)
  // Stored in E.164 (+919876543210) — see lib/phone.js. Messaging providers
  // reject anything else, and a number cannot be reliably fixed up later.
  phone           String?
  // WhatsApp requires explicit opt-in before a business may message someone,
  // so this has to be recorded per user rather than assumed from consent.
  whatsappOptIn   Boolean             @default(false)
  // Consent to marketing email, which nobody has given yet — hence the
  // default. Resend decides who a Broadcast actually reaches; this is our own
  // record of the permission, and what gets pushed to Resend when it changes.
  newsletterOptIn Boolean             @default(false)
  // When we told this person they had been subscribed by default. Set once,
  // so someone who unsubscribes afterwards is never subscribed again.
  newsletterNoticeSentAt DateTime?
  // A calendar date, not a moment — @db.Date so no timezone can shift a
  // birthday by a day. Nullable because every existing account predates it,
  // and nothing yet depends on having one.
  dateOfBirth     DateTime?           @db.Date
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  artistProfile   ArtistProfile?
  buyerOrders     Order[]             @relation("BuyerOrders")
  commissionBriefs CommissionRequest[] @relation("BuyerCommissionRequests")
  cartItems       CartItem[]
  messages        Message[]
  meetings        Meeting[]           @relation("BuyerMeetings")
  reviews         Review[]
  passwordResets  PasswordResetToken[]
  pushSubscriptions PushSubscription[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ArtistProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  displayName        String
  slug               String             @unique
  bio                String?
  discipline         String?
  location           String?
  website            String?
  verificationStatus VerificationStatus @default(PENDING)
  commissionRate     Decimal            @default(15.00) @db.Decimal(5, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworks           Artwork[]
  customRequests     CommissionRequest[]
  orders             Order[]
  payouts            Payout[]
  blogPosts          BlogPost[]
  portfolioPieces    PortfolioPiece[]
  reviews            Review[]
}

/// Past work an artist has already completed elsewhere. Not for sale — it exists
/// so collectors can judge an artist's range before commissioning them, which
/// matters most for artists who have nothing listed on the marketplace yet.
/// A piece can be a photo of finished work or a YouTube video — a process
/// recording, a walkthrough, a timelapse. Exactly one of imageUrl/videoUrl is
/// set, chosen by mediaType; both stay nullable at the schema level since
/// Prisma cannot express "exactly one of" as a constraint, and it is enforced
/// in the API layer instead.
model PortfolioPiece {
  id          String             @id @default(cuid())
  artistId    String
  title       String
  description String?
  medium      String?
  year        Int?
  mediaType   PortfolioMediaType @default(IMAGE)
  imageUrl    String?
  videoUrl    String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  artist      ArtistProfile      @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

/// Long-form writing an artist publishes on their own — process notes, studio
/// updates, exhibition write-ups. Kept intentionally simple: plain paragraphs
/// rather than rich text, since nothing else on the site renders formatted
/// content and a markdown/HTML pipeline is a much larger surface to secure.
model BlogPost {
  id           String         @id @default(cuid())
  artistId     String
  title        String
  slug         String         @unique
  excerpt      String?
  body         String
  coverImageUrl String?
  status       BlogPostStatus @default(DRAFT)
  publishedAt  DateTime?
  // When the artist last sent it for review; orders the admin queue.
  submittedAt  DateTime?
  reviewedAt   DateTime?
  // The admin's reason when a post is not approved, shown to the artist.
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  artist       ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([status, publishedAt])
}

model Artwork {
  id             String        @id @default(cuid())
  artistId       String
  title          String
  slug           String        @unique
  description    String
  category       String
  medium         String
  dimensions     String
  year           Int?
  priceCents     Int
  currency       String        @default("INR")
  status         ArtworkStatus @default(DRAFT)
  // Admin-pinned homepage hero. At most one row has this set — the API clears
  // the previous pin in the same transaction rather than relying on a constraint.
  isHero         Boolean       @default(false)
  shipsFrom      String?
  authenticity   String?
  edition        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  artist         ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  media          ArtworkMedia[]
  orders         Order[]
  reviews        Review[]
}

model ArtworkMedia {
  id        String  @id @default(cuid())
  artworkId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
}

/// A buyer's saved-for-checkout list. Every artwork is a unique original, so an
/// item is a reference rather than a quantity — the same piece cannot be in one
/// cart twice, and it disappears for everyone once it sells.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  artworkId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([userId, artworkId])
  @@index([userId])
}

model Order {
  id                    String             @id @default(cuid())
  buyerId               String
  artistId              String
  artworkId             String?
  commissionRequestId   String?
  subtotalCents         Int
  shippingCents         Int                @default(0)
  taxCents              Int                @default(0)
  buyerServiceFeeCents  Int                @default(0)
  platformCommissionCents Int
  artistPayoutCents     Int
  currency              String             @default("INR")
  status                OrderStatus        @default(PENDING_PAYMENT)
  shippingAddress       Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  buyer                 User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  artist                ArtistProfile      @relation(fields: [artistId], references: [id])
  artwork               Artwork?           @relation(fields: [artworkId], references: [id])
  commissionRequest     CommissionRequest? @relation(fields: [commissionRequestId], references: [id])
  transactions          Transaction[]
  review                Review?
}

model CommissionRequest {
  id              String           @id @default(cuid())
  buyerId         String
  artistId        String?
  title           String
  artworkType     String
  medium          String?
  budgetMinCents  Int?
  budgetMaxCents  Int?
  timeline        String?
  dimensions      String?
  requirements    String
  referenceUrls   String[]
  status          CommissionStatus @default(SUBMITTED)
  quotedPriceCents Int?
  currency        String           @default("INR")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  buyer           User             @relation("BuyerCommissionRequests", fields: [buyerId], references: [id])
  artist          ArtistProfile?   @relation(fields: [artistId], references: [id])
  meetings        Meeting[]
  messages        Message[]
  orders          Order[]
}

model Meeting {
  id                  String             @id @default(cuid())
  buyerId             String
  commissionRequestId String
  scheduledAt         DateTime
  durationMinutes     Int                @default(30)
  meetingType         String
  provider            String?
  providerMeetingId   String?
  joinUrl             String?
  status              MeetingStatus      @default(REQUESTED)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  buyer               User               @relation("BuyerMeetings", fields: [buyerId], references: [id])
  commissionRequest   CommissionRequest  @relation(fields: [commissionRequestId], references: [id], onDelete: Cascade)
}

model Message {
  id                  String            @id @default(cuid())
  senderId            String
  commissionRequestId String
  body                String
  createdAt           DateTime          @default(now())
  // Set once the daily follow-up cron emails the recipient about this
  // message because it was still unanswered 6+ hours after it was sent.
  // Messages get a push notification immediately, but the email is
  // deferred to this follow-up check to avoid emailing on every message
  // in an active back-and-forth.
  followupEmailSentAt DateTime?
  sender              User              @relation(fields: [senderId], references: [id])
  commissionRequest   CommissionRequest @relation(fields: [commissionRequestId], references: [id], onDelete: Cascade)
}

model Transaction {
  id               String            @id @default(cuid())
  orderId          String
  provider         String
  providerIntentId String?
  amountCents      Int
  currency         String            @default("INR")
  status           TransactionStatus @default(REQUIRES_PAYMENT)
  rawPayload       Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payout {
  id                 String        @id @default(cuid())
  artistId           String
  amountCents        Int
  currency           String        @default("INR")
  provider           String?
  providerPayoutId   String?
  status             String        @default("PENDING")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  artist             ArtistProfile @relation(fields: [artistId], references: [id])
}

model Review {
  id        String        @id @default(cuid())
  orderId   String        @unique
  buyerId   String
  artistId  String
  artworkId String?
  rating    Int
  body      String?
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer     User          @relation(fields: [buyerId], references: [id])
  artist    ArtistProfile @relation(fields: [artistId], references: [id])
  artwork   Artwork?      @relation(fields: [artworkId], references: [id])
}

// One row per rate-limit bucket (e.g. "signup:ip:1.2.3.4"). Hit counts and
// their window are updated in place by a single atomic upsert in lib/rateLimit.js
// rather than read-then-write, so concurrent requests on different serverless
// instances can't race each other into undercounting.
model RateLimitHit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// One row per browser/device a user has enabled notifications on — a user
// can have several (phone, laptop, ...). endpoint is unique because it's
// the push service's own identifier for that specific subscription.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
